# Base path for API calls. Left as a relative path so the Vite dev proxy (and
# nginx in production) can serve the API from the SAME ORIGIN as the SPA, which
# keeps the HttpOnly refresh cookie same-site.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api to.
VITE_DEV_PROXY_TARGET=http://localhost:5000

# PUBLISHABLE key only. This is designed to be public and is safe in the bundle.
# The SECRET key must never appear in any VITE_* variable - everything prefixed
# with VITE_ is inlined into the JavaScript that ships to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
