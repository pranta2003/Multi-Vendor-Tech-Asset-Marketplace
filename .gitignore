# --- Dependencies -------------------------------------------------------------
node_modules/

# --- Build output -------------------------------------------------------------
dist/
build/
*.tsbuildinfo

# --- Secrets ------------------------------------------------------------------
# THE MOST IMPORTANT LINES IN THIS FILE. Real credentials must never be
# committed. Only *.example templates are tracked.
.env
.env.*
!.env.example
!client/.env.example

# --- Logs / runtime -----------------------------------------------------------
*.log
npm-debug.log*
logs/
coverage/
*.pid

# --- Editors / OS -------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Prisma -------------------------------------------------------------------
# The generated client is a build artefact, reproduced by `prisma generate`.
# Committing it causes noisy diffs and platform-specific binaries in git.
server/prisma/generated/
