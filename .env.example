# ==============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it.
#
# This single file feeds docker-compose.yml. When running the API natively
# (npm --prefix server run dev), server/src/config/env.ts loads ../.env first and
# then server/.env, so this root file works for local development too.
#
# Every value is validated by a Zod schema at boot. A missing or malformed value
# stops the process with an explicit message instead of failing later at runtime -
# a misconfigured JWT secret should be a startup crash, never a silent auth hole.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Used by the postgres container to initialise itself, and composed into
# DATABASE_URL by docker-compose.yml. Change the password before any real deploy.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=marketplace_db

# Only needed for docker-compose.dev.yml, which publishes Postgres to the host.
# Change it if 5432 is already taken by a local PostgreSQL install.
POSTGRES_PORT=5432

# Set this ONLY when running the API natively against a database that
# docker-compose does not manage (e.g. RDS, Neon, Supabase, or a host install).
# Inside compose it is built automatically and this line is ignored.
# DATABASE_URL=postgresql://marketplace:change_this_password@localhost:5432/marketplace_db?schema=public

# ------------------------------------------------------------------------------
# Public origins
# ------------------------------------------------------------------------------
# The origins a BROWSER uses - not internal container hostnames.
#
# CLIENT_ORIGIN is the CORS allow-list entry and the base for payment redirect
# URLs. SERVER_ORIGIN is used to build the absolute IPN/webhook callback URLs
# handed to SSLCommerz and Stripe. If either is wrong, checkout appears to work
# and then strands the customer on a dead URL after payment - so treat these as
# release-critical, not cosmetic.
#
# Behind the bundled nginx the SPA and API share one origin, so both are the
# same public URL. In production: https://marketplace.example.com
CLIENT_ORIGIN=http://localhost:8080
SERVER_ORIGIN=http://localhost:8080

# Host port the nginx/SPA container is published on.
WEB_PORT=8080

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------
# MINIMUM 32 CHARACTERS EACH - enforced by Zod; the server exits if shorter.
#
# The two secrets MUST be different. They sign tokens with different lifetimes
# and different powers: if one key signed both, a stolen 15-minute access token
# could be replayed as a 7-day refresh token, defeating the entire rotation
# scheme.
#
# Generate:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48_output_aaaaaaaa
JWT_REFRESH_SECRET=replace_with_a_DIFFERENT_openssl_rand_value_bbbbbbbb

# Short access token: limits the damage window if one leaks, since access tokens
# are held in memory and sent on every request.
JWT_ACCESS_EXPIRES_IN=15m
# Long refresh token: kept in an HttpOnly cookie, rotated on every use, with
# reuse detection that revokes the whole token family.
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Cookies
# ------------------------------------------------------------------------------
# MUST be true in production - the server refuses to boot otherwise. A Secure
# cookie is only sent over HTTPS, so serve TLS or the browser silently discards
# the refresh cookie and every session dies after 15 minutes.
# Set to false ONLY for local plain-HTTP development.
COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
# lax blocks the cookie on cross-site POSTs (the CSRF vector) while still
# allowing normal top-level navigation back from a payment gateway.
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Stripe (international payments)
# ------------------------------------------------------------------------------
# SECRET key - server-side only. If this ever appears in a VITE_* variable it is
# published to every visitor; rotate it immediately.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` locally, or the Dashboard endpoint in production. Webhook
# signature verification is what makes fulfilment trustworthy: without it anyone
# could POST a fake "payment succeeded" and receive paid downloads for free.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# ------------------------------------------------------------------------------
# SSLCommerz (Bangladesh payments)
# ------------------------------------------------------------------------------
# Sandbox credentials come from the SSLCommerz merchant panel.
SSLCZ_STORE_ID=replace_me
SSLCZ_STORE_PASSWORD=replace_me
# false -> sandbox host, true -> live host. Deploying with `true` and sandbox
# credentials fails every transaction, so change both together.
SSLCZ_IS_LIVE=false
SSLCZ_CURRENCY=BDT

# ------------------------------------------------------------------------------
# API documentation
# ------------------------------------------------------------------------------
# Swagger UI is ALWAYS served in development. In production it is served only
# when this is exactly "true" - docker-compose defaults it to false.
#
# Set true here so the portfolio demo is explorable at /api/docs. For a real
# product, weigh it: interactive docs enumerate every endpoint, every payload
# shape and every validation rule, which is a genuine reconnaissance aid.
ENABLE_SWAGGER_UI=true

# ------------------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Deliberately far stricter than the global limit: this guards login, register
# and refresh against credential stuffing. Successful requests are not counted,
# so a legitimate user typing one wrong password is never penalised.
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# Frontend build-time values
# ------------------------------------------------------------------------------
# WARNING: every VITE_* value is INLINED INTO THE PUBLIC JAVASCRIPT BUNDLE at
# BUILD time. It is not read at runtime, so changing it requires a rebuild
# (`docker compose up --build`), and it must NEVER hold a secret.
VITE_API_BASE_URL=/api/v1
# PUBLISHABLE key (pk_...) only. This is designed to be public.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
